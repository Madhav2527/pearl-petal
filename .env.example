# ==========================================
# PETAL & PEARL (.env.example)
# Domain: https://thepearlpetals.in
# ==========================================

# Public Brand & Site
NEXT_PUBLIC_SITE_URL=https://thepearlpetals.in
NEXT_PUBLIC_BRAND_NAME=Petal & Pearl
NEXT_PUBLIC_TAGLINE=Beauty in Every Little Detail
NEXT_PUBLIC_SUPPORT_EMAIL=hello@thepearlpetals.in

# Supabase (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Razorpay Payment Gateway (India Prepaid Payments)
# Live keys: rzp_live_... / Test keys: rzp_test_...
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin Master Secret (Used as fallback security layer)
ADMIN_SECRET_KEY=petal_pearl_admin_secure_secret_2026
